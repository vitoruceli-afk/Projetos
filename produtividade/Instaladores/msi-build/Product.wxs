<?xml version="1.0" encoding="UTF-8"?>
<!--
  Empacota o instalador oficial do ActivityWatch (Inno Setup, em ..\activitywatch-v0.13.2-windows-x86_64-setup.exe)
  num MSI autonomo que, alem de instalar o AW silenciosamente, ja deixa tudo pronto para conversar
  com a aplicacao de Produtividade:
    - aw-server.toml gravado com host = 0.0.0.0 (sem isso a API so aceita conexao local, ver
      runbook de provisionamento)
    - regra de firewall de entrada liberando a porta 5600 apenas para o servidor da aplicacao
    - autostart via HKLM Run (nao a chave de usuario que o instalador do AW cria sozinho) - e o
      unico jeito de garantir que o ActivityWatch suba para QUALQUER usuario que logar na maquina,
      inclusive quando o MSI e empurrado via ferramenta de descoberta de rede rodando como SYSTEM,
      sem ninguem logado no momento da instalacao.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:fw="http://schemas.microsoft.com/wix/FirewallExtension">

  <Product Id="*"
           Name="ActivityWatch (Produtividade FAESA)"
           Language="1046"
           Version="0.13.4.0"
           Manufacturer="FAESA - Nucleo de Tecnologia da Informacao"
           UpgradeCode="9F1B7C2A-4E3D-4B8A-9C6E-7A2F5D1B0E44">

    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" Platform="x86"
             Description="Instala o ActivityWatch e configura a maquina para ser monitorada pela aplicacao de Produtividade"
             Comments="Gerado a partir do instalador oficial ActivityWatch v0.13.2" />

    <!-- ATENCAO: o Windows Installer IGNORA o 4o campo de Version na comparacao de versoes
         (0.13.2.8 == 0.13.2.9 para ele). Pra a atualizacao por cima funcionar (remover a versao
         anterior), a mudanca precisa estar nos 3 primeiros campos - ex.: 0.13.2.x -> 0.13.3.0. -->
    <MajorUpgrade DowngradeErrorMessage="Ja existe uma versao mais nova deste pacote instalada." />
    <MediaTemplate EmbedCab="yes" />

    <!-- IP do servidor onde a aplicacao de Produtividade roda hoje (mesma maquina, NO01-017461).
         Sobrescreva na linha de comando se a aplicacao for movida para outro servidor:
           msiexec /i ActivityWatch-Produtividade.msi SERVERIP="10.1.100.50" /quiet -->
    <Property Id="SERVERIP" Value="10.10.140.17" Secure="yes" />

    <Condition Message="E preciso ter direitos de administrador para instalar o ActivityWatch nesta maquina.">
      <![CDATA[Privileged]]>
    </Condition>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFilesFolder">
        <Directory Id="INSTALLFOLDER" Name="ActivityWatch-Produtividade">

          <Component Id="CompAwSetupExe" Guid="6C8F1A2E-0B3D-4C9A-8E1F-2D4B6A9C7E10">
            <File Id="AwSetupExe" Name="activitywatch-setup.exe"
                  Source="..\activitywatch-v0.13.2-windows-x86_64-setup.exe" KeyPath="yes" />
          </Component>

          <Component Id="CompLauncherVbs" Guid="1A2B3C4D-5E6F-4A7B-8C9D-0E1F2A3B4C5D">
            <File Id="AwLauncherVbs" Name="aw-launcher.vbs" Source="payload\aw-launcher.vbs" KeyPath="yes" />
          </Component>

          <Component Id="CompTemplateToml" Guid="2B3C4D5E-6F70-4B8C-9D0E-1F2A3B4C5D6E">
            <File Id="AwServerDefaultToml" Name="aw-server.default.toml" Source="payload\aw-server.default.toml" KeyPath="yes" />
          </Component>

          <!-- Agente proprio (nao e um watcher oficial do ActivityWatch, nao modifica a instalacao
               dele) que reporta o usuario Windows logado para o aw-server local, via a mesma API
               REST publica que aw-watcher-window/afk ja usam. Ver Agentes\aw-watcher-currentuser\. -->
          <Component Id="CompAgenteUsuarioScript" Guid="5E6F7081-9203-4EBF-B031-4B5C6D7E8F91">
            <File Id="AgenteUsuarioScript" Name="aw-watcher-currentuser.ps1" Source="..\..\Agentes\aw-watcher-currentuser\aw-watcher-currentuser.ps1" KeyPath="yes" />
          </Component>

          <!-- Wrapper pra Tarefa Agendada rodar o script acima sem nenhum flash de console - ver
               comentario dentro do proprio .vbs. -->
          <Component Id="CompAgenteUsuarioRunHidden" Guid="8192031A-4B25-4EC1-B364-7D8E9F102435">
            <File Id="AgenteUsuarioRunHidden" Name="run-hidden.vbs" Source="..\..\Agentes\aw-watcher-currentuser\run-hidden.vbs" KeyPath="yes" />
          </Component>

          <Component Id="CompAgenteUsuarioTaskXml" Guid="6F708192-0314-4CF0-9142-5C6D7E8F9102">
            <File Id="AgenteUsuarioTaskXml" Name="task-aw-watcher-currentuser.xml" Source="..\..\Agentes\aw-watcher-currentuser\task-aw-watcher-currentuser.xml" KeyPath="yes" />
          </Component>

          <!-- Segundo agente proprio (tambem nao e um watcher oficial do ActivityWatch): reporta
               eventos PONTUAIS de login/bloqueio/desbloqueio de tela (distinto do heartbeat continuo
               do aw-watcher-currentuser acima) - pedido explicito pra estatisticas de uso do
               dispositivo mais fieis que o AFK sozinho (que so enxerga tempo sem teclado/mouse, nao
               sabe se a tela estava DE FATO bloqueada). Ver Agentes\aw-watcher-sessionevents\. -->
          <Component Id="CompAgenteSessaoScript" Guid="9A1B2C3D-4E5F-4061-8A7B-1C2D3E4F5061">
            <File Id="AgenteSessaoScript" Name="aw-watcher-sessionevents.ps1" Source="..\..\Agentes\aw-watcher-sessionevents\aw-watcher-sessionevents.ps1" KeyPath="yes" />
          </Component>

          <Component Id="CompAgenteSessaoRunHidden" Guid="1B2C3D4E-5F60-4172-9B8C-2D3E4F506172">
            <File Id="AgenteSessaoRunHidden" Name="run-hidden-sessionevents.vbs" Source="..\..\Agentes\aw-watcher-sessionevents\run-hidden-sessionevents.vbs" KeyPath="yes" />
          </Component>

          <!-- Uma Tarefa Agendada por gatilho (login/lock/unlock) - o Agendador de Tarefas nao
               permite que gatilhos diferentes dentro de UMA MESMA tarefa passem argumentos
               diferentes pra mesma acao, entao sao 3 tarefas pequenas em vez de uma so. -->
          <Component Id="CompAgenteSessaoTaskLoginXml" Guid="2C3D4E5F-6071-4283-AC9D-3E4F50617283">
            <File Id="AgenteSessaoTaskLoginXml" Name="task-aw-watcher-sessionevents-login.xml" Source="..\..\Agentes\aw-watcher-sessionevents\task-aw-watcher-sessionevents-login.xml" KeyPath="yes" />
          </Component>

          <Component Id="CompAgenteSessaoTaskLockXml" Guid="3D4E5F60-7182-4394-BDAE-4F5061728394">
            <File Id="AgenteSessaoTaskLockXml" Name="task-aw-watcher-sessionevents-lock.xml" Source="..\..\Agentes\aw-watcher-sessionevents\task-aw-watcher-sessionevents-lock.xml" KeyPath="yes" />
          </Component>

          <Component Id="CompAgenteSessaoTaskUnlockXml" Guid="4E5F6071-8293-44A5-CEBF-5061728394A5">
            <File Id="AgenteSessaoTaskUnlockXml" Name="task-aw-watcher-sessionevents-unlock.xml" Source="..\..\Agentes\aw-watcher-sessionevents\task-aw-watcher-sessionevents-unlock.xml" KeyPath="yes" />
          </Component>

          <!-- Tarefa agendada sob demanda (sem gatilho proprio) so para religar o ActivityWatch na
               sessao do usuario logado logo apos um "Atualizar" - ver CustomActions
               RegistrarTarefaReligar/ReligarActivityWatch abaixo. -->
          <Component Id="CompTaskReligarXml" Guid="7081920A-1425-4DA1-A253-6D7E8F910213">
            <File Id="TaskReligarXml" Name="task-aw-religar.xml" Source="payload\task-aw-religar.xml" KeyPath="yes" />
          </Component>

          <!-- HKLM Run (nao HKCU) para valer para qualquer usuario que logar, nao so quem estava
               logado durante a instalacao. wscript em vez de cscript para nao abrir console. -->
          <Component Id="CompRunKey" Guid="3C4D5E6F-7081-4C9D-AE1F-2A3B4C5D6E7F">
            <RegistryValue Root="HKLM"
                           Key="Software\Microsoft\Windows\CurrentVersion\Run"
                           Name="ActivityWatch_Produtividade"
                           Type="string"
                           Value="wscript.exe &quot;[INSTALLFOLDER]aw-launcher.vbs&quot;"
                           KeyPath="yes" />
          </Component>

          <!-- Regra de firewall: so o IP do servidor da aplicacao consegue falar com a API do
               aw-server (que nao tem autenticacao propria). -->
          <Component Id="CompFirewall" Guid="4D5E6F70-8192-4DAE-BF20-3A4B5C6D7E80">
            <RegistryValue Root="HKLM"
                           Key="Software\FAESA\ProdutividadeAW"
                           Name="FirewallConfigured"
                           Type="integer"
                           Value="1"
                           KeyPath="yes" />
            <fw:FirewallException Id="AwFirewallRule"
                                   Name="ActivityWatch - Produtividade FAESA"
                                   Description="Permite que o servidor da aplicacao de Produtividade sincronize os dados do ActivityWatch desta maquina."
                                   Port="5600"
                                   Protocol="tcp"
                                   Profile="all"
                                   IgnoreFailure="yes">
              <fw:RemoteAddress>[SERVERIP]</fw:RemoteAddress>
            </fw:FirewallException>
          </Component>

        </Directory>
      </Directory>
    </Directory>

    <Feature Id="MainFeature" Title="ActivityWatch + integracao com Produtividade" Level="1">
      <ComponentRef Id="CompAwSetupExe" />
      <ComponentRef Id="CompLauncherVbs" />
      <ComponentRef Id="CompTemplateToml" />
      <ComponentRef Id="CompAgenteUsuarioScript" />
      <ComponentRef Id="CompAgenteUsuarioRunHidden" />
      <ComponentRef Id="CompAgenteUsuarioTaskXml" />
      <ComponentRef Id="CompAgenteSessaoScript" />
      <ComponentRef Id="CompAgenteSessaoRunHidden" />
      <ComponentRef Id="CompAgenteSessaoTaskLoginXml" />
      <ComponentRef Id="CompAgenteSessaoTaskLockXml" />
      <ComponentRef Id="CompAgenteSessaoTaskUnlockXml" />
      <ComponentRef Id="CompTaskReligarXml" />
      <ComponentRef Id="CompRunKey" />
      <ComponentRef Id="CompFirewall" />
    </Feature>

    <!-- Instala o ActivityWatch em modo silencioso, sem reiniciar e sem caixas de mensagem.
         /SP- suprime a pergunta "This will install... Do you wish to continue?". /ALLUSERS forca
         o modo de instalacao "para toda a maquina" do proprio Inno Setup explicitamente, em vez de
         depender da deteccao automatica dele.
         /LOG grava o log PROPRIO do Inno Setup (independente do log do msiexec) - foi o que revelou
         a causa real de uma instalacao "bem sucedida" que nao aparecia em Program Files: o Inno
         decidiu sozinho fazer instalacao por usuario (current user), dentro do perfil "Default"
         (que nenhum usuario real usa), porque com Impersonate="no" a acao roda como LocalSystem, e
         a checagem interna do Inno de "e administrador?" so olha se a conta e MEMBRO do grupo
         Administradores - LocalSystem tem privilegio maior que qualquer admin, mas nao e "membro"
         desse grupo, entao a deteccao dava negativo. Com Impersonate="yes" (o padrao do MSI, que
         estava sendo sobrescrito aqui), a acao passa a rodar com o token de quem chamou o msiexec -
         no nosso caso, a propria conta de administrador autenticada via WMI - que o Inno reconhece
         corretamente como administrador. O /ALLUSERS fica como reforco, independente da deteccao. -->
    <CustomAction Id="InstallActivityWatch"
                  FileKey="AwSetupExe"
                  ExeCommand="/VERYSILENT /SUPPRESSMSGBOXES /NORESTART /SP- /ALLUSERS /LOG=&quot;C:\Windows\Temp\aw-inno-install.log&quot;"
                  Execute="deferred"
                  Return="check" />

    <!-- Mata os processos do ActivityWatch antes de reinstalar/atualizar. Necessario porque, numa
         instalacao remota via WMI/DCOM, o msiexec roda numa sessao nao-interativa (sessao 0),
         diferente da sessao onde aw-qt.exe do usuario esta rodando; o RestartManager do proprio
         Inno Setup detecta os processos abertos mas desiste de fecha-los sozinho ("Session
         Mismatch") e a instalacao falha com Erro 1722 (DeleteFile: Acesso negado) tentando
         sobrescrever o .exe travado. Reproduzido e diagnosticado via log do Inno em MI01-007900
         durante um "Atualizar". Return=ignore: numa instalacao nova (NOT Installed mas sem AW
         previamente rodando) nao ha nada para matar, e taskkill retorna erro nesse caso - isso e
         esperado, nao deve derrubar a instalacao. -->
    <CustomAction Id="PararActivityWatch"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[SystemFolder]taskkill.exe&quot; /F /T /IM aw-qt.exe /IM aw-server.exe /IM aw-watcher-afk.exe /IM aw-watcher-window.exe"
                  Execute="deferred"
                  Return="ignore" />

    <!-- Desinstala o ActivityWatch de verdade quando este pacote e removido - sem isso, remover
         o MSI so tiraria nossos arquivos de integracao e deixaria o AW instalado sozinho. -->
    <CustomAction Id="UninstallActivityWatch"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[ProgramFilesFolder]ActivityWatch\unins000.exe&quot; /VERYSILENT /SUPPRESSMSGBOXES /NORESTART"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!-- Registra a Tarefa Agendada do agente proprio (Agentes\aw-watcher-currentuser) para RODAR
         COMO O USUARIO QUE ESTIVER LOGADO (Principal por GroupId "Users" no XML, nao um usuario
         fixo) - isso só e possivel aqui porque o CustomAction roda com o token de administrador de
         quem chamou o msiexec (ver InstallActivityWatch acima); tentar registrar essa mesma tarefa
         via "schtasks /create /xml" sem elevacao (ex: sessao interativa comum) da "Acesso negado".
         Return=ignore: preferimos o ActivityWatch instalado sem o agente a uma instalacao inteira
         falhando por causa dele. -->
    <CustomAction Id="RegistrarTarefaAgente"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[SystemFolder]schtasks.exe&quot; /create /tn &quot;AW_WatcherUsuarioLogado&quot; /xml &quot;[INSTALLFOLDER]task-aw-watcher-currentuser.xml&quot; /f"
                  Execute="deferred"
                  Return="ignore" />

    <!-- Contraparte no uninstall - sem isso, remover o MSI deixaria a tarefa agendada orfa rodando
         para sempre (o .ps1 que ela chama teria sido apagado, mas a tarefa em si continuaria
         cadastrada, falhando silenciosamente a cada execucao). -->
    <CustomAction Id="RemoverTarefaAgente"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[SystemFolder]schtasks.exe&quot; /delete /tn &quot;AW_WatcherUsuarioLogado&quot; /f"
                  Execute="deferred"
                  Return="ignore" />

    <!-- Mesmo mecanismo de RegistrarTarefaAgente acima, uma vez pra cada uma das 3 tarefas do
         aw-watcher-sessionevents (login/lock/unlock - ver comentario no Component correspondente).
         Nao ha "Religar" equivalente pra essas: diferente do heartbeat continuo do
         AW_WatcherUsuarioLogado (vale a pena forcar um refresh logo apos instalar/atualizar),
         login/lock/unlock sao fatos pontuais - forcar um "login" sintetico no momento da instalacao
         registraria um evento que nao aconteceu de verdade. Passa a capturar a partir do proximo
         gatilho real (proximo logon/bloqueio/desbloqueio), sem backfill nenhum. -->
    <CustomAction Id="RegistrarTarefaSessaoLogin"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[SystemFolder]schtasks.exe&quot; /create /tn &quot;AW_SessaoLogin&quot; /xml &quot;[INSTALLFOLDER]task-aw-watcher-sessionevents-login.xml&quot; /f"
                  Execute="deferred"
                  Return="ignore" />

    <CustomAction Id="RegistrarTarefaSessaoLock"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[SystemFolder]schtasks.exe&quot; /create /tn &quot;AW_SessaoLock&quot; /xml &quot;[INSTALLFOLDER]task-aw-watcher-sessionevents-lock.xml&quot; /f"
                  Execute="deferred"
                  Return="ignore" />

    <CustomAction Id="RegistrarTarefaSessaoUnlock"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[SystemFolder]schtasks.exe&quot; /create /tn &quot;AW_SessaoUnlock&quot; /xml &quot;[INSTALLFOLDER]task-aw-watcher-sessionevents-unlock.xml&quot; /f"
                  Execute="deferred"
                  Return="ignore" />

    <!-- Contraparte no uninstall das 3 acima, mesmo motivo de RemoverTarefaAgente. -->
    <CustomAction Id="RemoverTarefaSessaoLogin"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[SystemFolder]schtasks.exe&quot; /delete /tn &quot;AW_SessaoLogin&quot; /f"
                  Execute="deferred"
                  Return="ignore" />

    <CustomAction Id="RemoverTarefaSessaoLock"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[SystemFolder]schtasks.exe&quot; /delete /tn &quot;AW_SessaoLock&quot; /f"
                  Execute="deferred"
                  Return="ignore" />

    <CustomAction Id="RemoverTarefaSessaoUnlock"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[SystemFolder]schtasks.exe&quot; /delete /tn &quot;AW_SessaoUnlock&quot; /f"
                  Execute="deferred"
                  Return="ignore" />

    <!-- Registra uma tarefa SOB DEMANDA (sem gatilho proprio - so pode ser disparada por
         ReligarActivityWatch, abaixo, ou manualmente) cuja acao e so rodar o aw-launcher.vbs ja
         existente. Existe so para dar a ReligarActivityWatch um jeito de entregar isso na sessao
         interativa certa - Task Scheduler resolve essa entrega igual ja faz para
         AW_WatcherUsuarioLogado; um CustomAction do MSI sozinho (sessao 0) nao consegue. -->
    <CustomAction Id="RegistrarTarefaReligar"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[SystemFolder]schtasks.exe&quot; /create /tn &quot;AW_ReligarPosAtualizacao&quot; /xml &quot;[INSTALLFOLDER]task-aw-religar.xml&quot; /f"
                  Execute="deferred"
                  Return="ignore" />

    <!-- Dispara a tarefa acima uma vez, logo apos o Inno terminar - fecha a lacuna criada por
         PararActivityWatch: sem isso, a maquina so voltaria a sincronizar no proximo logon/reboot
         do usuario (o HKLM Run so dispara em sessao NOVA). O aw-launcher.vbs ja e idempotente
         ("so inicia se aw-qt.exe ainda nao estiver rodando"), entao rodar isso tambem numa
         instalacao nova (onde nao havia nada para matar) e inofensivo. Return=ignore: se nao
         houver ninguem logado no momento (instalacao via ferramenta de descoberta, sem sessao
         interativa), a tarefa so nao acha sessao para rodar - o HKLM Run cobre esse caso no
         proximo logon, como sempre cobriu. -->
    <CustomAction Id="ReligarActivityWatch"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[SystemFolder]schtasks.exe&quot; /run /tn &quot;AW_ReligarPosAtualizacao&quot;"
                  Execute="deferred"
                  Return="ignore" />

    <!-- Contraparte no uninstall, mesmo motivo de RemoverTarefaAgente. -->
    <CustomAction Id="RemoverTarefaReligar"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[SystemFolder]schtasks.exe&quot; /delete /tn &quot;AW_ReligarPosAtualizacao&quot; /f"
                  Execute="deferred"
                  Return="ignore" />

    <!-- Mesma lacuna de ReligarActivityWatch, so que para o agente de usuario: AW_WatcherUsuarioLogado
         usa LogonTrigger, entao so comeca a rodar (e so entao cria o bucket aw-watcher-currentuser e
         preenche "Usuario responsavel") depois de um novo logon - o que ReligarActivityWatch agora
         torna desnecessario para o ActivityWatch em si, entao a sessao pode nunca ser reiniciada e
         o agente nunca chega a rodar. "ping -n 6" da ~5s de folga para o aw-server (que
         ReligarActivityWatch acabou de mandar subir, sem esperar) terminar de abrir a porta 5600
         antes do agente tentar postar nela - sem essa folga o primeiro POST falharia (silenciosamente,
         por design) e so seria tentado de novo no proximo logon real, ja que rodar via "/run" e uma
         execucao avulsa, sem a repeticao de 5 em 5 min que so vale para o gatilho de logon. -->
    <CustomAction Id="ReligarAgenteUsuario"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[SystemFolder]cmd.exe&quot; /c ping -n 6 127.0.0.1 >nul &amp; &quot;[SystemFolder]schtasks.exe&quot; /run /tn &quot;AW_WatcherUsuarioLogado&quot;"
                  Execute="deferred"
                  Return="ignore" />

    <!-- Forca a instalacao da extensao "ActivityWatch Web Watcher" (aw-watcher-web) no Chrome e no
         Edge para TODOS os usuarios da maquina, via politica de navegador (ExtensionInstallForcelist)
         - e ela que envia a URL/titulo da aba ao aw-server local, o que o watcher de janela sozinho
         nao consegue (tipo 'web' em eventos, ver aw_client.php). Sem isso seria preciso instalar a
         extensao maquina por maquina.
         Por que reg.exe /reg:64 em vez de <RegistryValue>: este pacote e x86 (Platform="x86") e o
         Windows redireciona HKLM\SOFTWARE gravado por processo 32-bit para WOW6432Node, onde Chrome e
         Edge (64-bit) NAO leem politicas. O /reg:64 grava na visao nativa. O nome do valor (9071) e
         propositalmente alto pra nao sobrescrever entradas 1, 2, 3... que uma GPO do dominio ja
         tenha criado nessa mesma lista. Id da extensao na Chrome Web Store:
         nglaklhklhcoonedhgnpgddginnjdadi - o Edge instala a partir da mesma loja (URL
         clients2.google.com), o que o Edge so permite em maquinas ingressadas no dominio (e o caso
         aqui, usuarios FAESA\...). A extensao fala com http://localhost:5600 (mesmo aw-server local).
         Firefox NAO e coberto (exige policies.json na pasta do Firefox, nao registro). -->
    <CustomAction Id="ForcarExtensaoWebChrome"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[SystemFolder]reg.exe&quot; add &quot;HKLM\SOFTWARE\Policies\Google\Chrome\ExtensionInstallForcelist&quot; /v 9071 /t REG_SZ /d &quot;nglaklhklhcoonedhgnpgddginnjdadi;https://clients2.google.com/service/update2/crx&quot; /f /reg:64"
                  Execute="deferred"
                  Return="ignore" />

    <CustomAction Id="ForcarExtensaoWebEdge"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[SystemFolder]reg.exe&quot; add &quot;HKLM\SOFTWARE\Policies\Microsoft\Edge\ExtensionInstallForcelist&quot; /v 9071 /t REG_SZ /d &quot;nglaklhklhcoonedhgnpgddginnjdadi;https://clients2.google.com/service/update2/crx&quot; /f /reg:64"
                  Execute="deferred"
                  Return="ignore" />

    <!-- Contraparte no uninstall: remove so o nosso valor (9071), sem mexer no resto da lista. -->
    <CustomAction Id="RemoverExtensaoWebChrome"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[SystemFolder]reg.exe&quot; delete &quot;HKLM\SOFTWARE\Policies\Google\Chrome\ExtensionInstallForcelist&quot; /v 9071 /f /reg:64"
                  Execute="deferred"
                  Return="ignore" />

    <CustomAction Id="RemoverExtensaoWebEdge"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[SystemFolder]reg.exe&quot; delete &quot;HKLM\SOFTWARE\Policies\Microsoft\Edge\ExtensionInstallForcelist&quot; /v 9071 /f /reg:64"
                  Execute="deferred"
                  Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="PararActivityWatch" Before="InstallActivityWatch">NOT Installed</Custom>
      <Custom Action="InstallActivityWatch" After="InstallFiles">NOT Installed</Custom>
      <Custom Action="RegistrarTarefaAgente" After="InstallActivityWatch">NOT Installed</Custom>
      <Custom Action="RegistrarTarefaSessaoLogin" After="RegistrarTarefaAgente">NOT Installed</Custom>
      <Custom Action="RegistrarTarefaSessaoLock" After="RegistrarTarefaSessaoLogin">NOT Installed</Custom>
      <Custom Action="RegistrarTarefaSessaoUnlock" After="RegistrarTarefaSessaoLock">NOT Installed</Custom>
      <Custom Action="RegistrarTarefaReligar" After="RegistrarTarefaSessaoUnlock">NOT Installed</Custom>
      <Custom Action="ReligarActivityWatch" After="RegistrarTarefaReligar">NOT Installed</Custom>
      <Custom Action="ReligarAgenteUsuario" After="ReligarActivityWatch">NOT Installed</Custom>
      <Custom Action="ForcarExtensaoWebChrome" After="ReligarAgenteUsuario">NOT Installed</Custom>
      <Custom Action="ForcarExtensaoWebEdge" After="ForcarExtensaoWebChrome">NOT Installed</Custom>
      <Custom Action="RemoverExtensaoWebEdge" Before="RemoverTarefaSessaoLogin">REMOVE="ALL"</Custom>
      <Custom Action="RemoverExtensaoWebChrome" Before="RemoverExtensaoWebEdge">REMOVE="ALL"</Custom>
      <Custom Action="RemoverTarefaReligar" Before="RemoverTarefaAgente">REMOVE="ALL"</Custom>
      <Custom Action="RemoverTarefaSessaoUnlock" Before="RemoverTarefaReligar">REMOVE="ALL"</Custom>
      <Custom Action="RemoverTarefaSessaoLock" Before="RemoverTarefaSessaoUnlock">REMOVE="ALL"</Custom>
      <Custom Action="RemoverTarefaSessaoLogin" Before="RemoverTarefaSessaoLock">REMOVE="ALL"</Custom>
      <Custom Action="RemoverTarefaAgente" Before="UninstallActivityWatch">REMOVE="ALL"</Custom>
      <Custom Action="UninstallActivityWatch" Before="RemoveFiles">REMOVE="ALL"</Custom>
    </InstallExecuteSequence>

  </Product>
</Wix>
